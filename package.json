{
  "name": "ats-website",
  "private": true,
  "version": "0.0.0",
  "description": "Active Technical Services static website",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "node scripts/run-in-workspace.mjs run dev --workspace=@ats/web",
    "dev:web": "node scripts/run-in-workspace.mjs run dev --workspace=@ats/web",
    "build": "npm run build:web",
    "build:web": "npm run content:check && node scripts/build-web.mjs",
    "lint": "eslint apps scripts eslint.config.mjs vitest.config.ts",
    "typecheck": "node scripts/run-in-workspace.mjs run typecheck --workspaces --if-present",
    "test": "vitest run",
    "content:generate": "node scripts/generate-public-content.mjs",
    "content:check": "node scripts/check-public-content.mjs",
    "verify": "npm run content:check && npm run lint && npm run typecheck && npm run test && npm run build:web"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "eslint": "9.34.0",
    "eslint-config-next": "16.3.3",
    "globals": "16.3.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vitest": "3.2.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "jsdom": "26.1.0"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10"
  },
  "license": "UNLICENSED"
}
