# Optional browser-safe origins. The static site remains usable when these are empty.
# NEXT_PUBLIC_API_BASE_URL must be an origin only, for example http://127.0.0.1:3001
# NEXT_PUBLIC_NEON_AUTH_BASE_URL may include a documented Neon Auth path such as /neondb/auth
# Do not put database URLs, server secrets, R2 keys, Resend keys, or deploy-hook URLs here.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_NEON_AUTH_BASE_URL=
